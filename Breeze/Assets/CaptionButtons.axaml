<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CaptionGlyph">#1B1B1F</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionRestBackground">#00E4E4EA</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionHoverBackground">#E4E4EA</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionPressedBackground">#D5D5DE</SolidColorBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CaptionGlyph">#F2F2F5</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionRestBackground">#0026262C</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionHoverBackground">#26262C</SolidColorBrush>
      <SolidColorBrush x:Key="CaptionPressedBackground">#31313A</SolidColorBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="CaptionCloseHoverBackground">#E81123</SolidColorBrush>
  <SolidColorBrush x:Key="CaptionClosePressedBackground">#C42B1C</SolidColorBrush>

  <ControlTheme x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CaptionGlyph}" />
    <Setter Property="Background" Value="{DynamicResource CaptionRestBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Surface" Background="{TemplateBinding Background}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CaptionHoverBackground}" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource CaptionPressedBackground}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBackground}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource CaptionClosePressedBackground}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </ControlTheme>

  <!-- Firefox style window controls: hairline glyphs on whole pixels, identical hit targets. -->
  <ControlTheme x:Key="{x:Type chrome:CaptionButtons}" TargetType="chrome:CaptionButtons">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2">

          <Button Name="PART_MinimizeButton"
                  Theme="{StaticResource CaptionButton}"
                  ToolTip.Tip="Minimize"
                  AutomationProperties.Name="Minimize">
            <Rectangle Width="10" Height="1" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Button Name="PART_RestoreButton"
                  Theme="{StaticResource CaptionButton}"
                  ToolTip.Tip="Maximize"
                  AutomationProperties.Name="Maximize">
            <Panel Width="10" Height="10">
              <Border Name="MaximizeGlyph"
                      Width="10"
                      Height="10"
                      BorderThickness="1"
                      BorderBrush="{Binding $parent[Button].Foreground}" />
              <Panel Name="RestoreGlyph" IsVisible="False">
                <Border Width="8"
                        Height="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderThickness="1"
                        BorderBrush="{Binding $parent[Button].Foreground}" />
                <Border Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderThickness="1"
                        BorderBrush="{Binding $parent[Button].Foreground}" />
              </Panel>
            </Panel>
          </Button>

          <Button Name="PART_CloseButton"
                  Theme="{StaticResource CaptionCloseButton}"
                  ToolTip.Tip="Close"
                  AutomationProperties.Name="Close">
            <PathIcon Data="{DynamicResource IconDismiss}"
                      Width="10"
                      Height="10"
                      Foreground="{Binding $parent[Button].Foreground}" />
          </Button>

        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Windows gives the caption area less height when maximized, so the buttons shrink to fit. -->
    <Style Selector="^:maximized /template/ Button, ^:fullscreen /template/ Button">
      <Setter Property="Height" Value="23" />
    </Style>

    <Style Selector="^:maximized /template/ Border#MaximizeGlyph">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:maximized /template/ Panel#RestoreGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
