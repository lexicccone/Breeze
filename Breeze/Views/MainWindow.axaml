<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:Breeze.Controls"
        xmlns:vm="using:Breeze.ViewModels"
        xmlns:views="using:Breeze.Views"
        x:Class="Breeze.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Breeze"
        Icon="/Assets/Brand/breeze.ico"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.close">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- One state model for every icon button: transparent at rest, subtle hover and
         pressed fills, and a dimmed icon rather than a grey plate when disabled. -->
    <Style Selector="Button.tool /template/ ContentPresenter, Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.tool:pointerover /template/ ContentPresenter, Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.tool:pressed /template/ ContentPresenter, Button.close:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
    </Style>

    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
    </Style>

    <Style Selector="Button.tool:disabled PathIcon">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
    </Style>

    <Style Selector="Button.close PathIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
    </Style>

    <!-- The window's own title bar layer sits in the off screen frame when maximized, which
         clipped the caption buttons; inset it by the same margin as the content. -->
    <Style Selector="chrome|TitleBar">
      <Setter Property="Margin" Value="{Binding $parent[Window].OffScreenMargin}" />
    </Style>

    <!-- Downloads popup: same surface and hairline as the rest of the chrome. -->
    <Style Selector="Border.downloads">
      <Setter Property="Width" Value="330" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorder}" />
      <Setter Property="Background" Value="{DynamicResource ToolbarBackground}" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #33000000" />
    </Style>

    <Style Selector="Border.download">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource TabRestBackground}" />
    </Style>

    <Style Selector="Border.download:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>

    <Style Selector="Button.mini">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.mini PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.mini /template/ ContentPresenter, Button.link /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.mini:pointerover /template/ ContentPresenter, Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.mini:pressed /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
    </Style>

    <!-- Bookmark bar entries: same flat, borderless state model as the toolbar buttons. -->
    <Style Selector="Button.bookmark">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.bookmark /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.bookmark:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.bookmark:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
    </Style>

    <!-- Padding lives in styles, not on the elements, so the maximized rules below can win. -->
    <Style Selector="Border.toolbar">
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Border.bookmarks">
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector="controls|DragArea.chrome">
      <Setter Property="Padding" Value="6,5,128,0" />
    </Style>

    <!-- Maximized and fullscreen windows sit flush against the display edges, so the
         chrome gains a small safe area. Windowed spacing is untouched. -->
    <Style Selector="Window[WindowState=Maximized] Border.toolbar, Window[WindowState=FullScreen] Border.toolbar">
      <Setter Property="Padding" Value="16,6" />
    </Style>

    <Style Selector="Window[WindowState=Maximized] Border.bookmarks, Window[WindowState=FullScreen] Border.bookmarks">
      <Setter Property="Padding" Value="14,4" />
    </Style>

    <Style Selector="Window[WindowState=Maximized] controls|DragArea.chrome, Window[WindowState=FullScreen] controls|DragArea.chrome">
      <Setter Property="Padding" Value="14,5,128,0" />
    </Style>

    <Style Selector="TextBox.address">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource TabRestBackground}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarBackground}" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.close">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="ListBox.tabs ListBoxItem:selected Button.close">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <!-- When maximized Windows pushes part of the window off screen; inset the content by that
       amount so the title bar row stays fully visible. -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">

    <controls:DragArea DockPanel.Dock="Top"
                       Classes="chrome"
                       Background="{DynamicResource ChromeBackground}">
      <DockPanel LastChildFill="False">
        <controls:TabStrip DockPanel.Dock="Left"
                           Classes="tabs"
                           Reserve="32"
                           ItemsSource="{Binding Tabs}"
                           SelectedItem="{Binding SelectedTab}"
                           ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="Tabs">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:TabViewModel">
              <Grid ColumnDefinitions="16,*,20" ColumnSpacing="8">
                <Panel Grid.Column="0" Width="16" Height="16">
                  <Image Source="{Binding Favicon}" IsVisible="{Binding HasFavicon}" Width="16" Height="16" />
                  <PathIcon Data="{StaticResource IconGlobe}"
                            Foreground="{DynamicResource GlyphBrush}"
                            IsVisible="{Binding ShowGlobe}"
                            Width="14"
                            Height="14" />
                  <PathIcon Data="{StaticResource IconSettings}"
                            Foreground="{DynamicResource GlyphBrush}"
                            IsVisible="{Binding !IsWebPage}"
                            Width="14"
                            Height="14" />
                </Panel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Classes="close"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="Close tab"
                        AutomationProperties.Name="Close tab">
                  <PathIcon Data="{StaticResource IconDismiss}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </controls:TabStrip>

        <Button DockPanel.Dock="Left"
                Classes="tool"
                Width="28"
                Height="28"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding NewTabCommand}"
                ToolTip.Tip="New tab"
                AutomationProperties.Name="New tab">
          <PathIcon Data="{StaticResource IconAdd}" Width="15" Height="15" />
        </Button>
      </DockPanel>
    </controls:DragArea>

    <!-- Toolbar and bookmark bar share one background and one separator, so showing the bar does
         not add a second hairline across the window. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackground}"
            BorderBrush="{DynamicResource ToolbarBorder}"
            BorderThickness="0,0,0,1">
      <StackPanel>

        <Border Classes="toolbar">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">

            <Button Grid.Column="0"
                    Classes="tool"
                    Command="{Binding SelectedTab.BackCommand}"
                    controls:MiddleClick.Command="{Binding SelectedTab.BackInNewTabCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoBack}"
                    ToolTip.Tip="Back"
                    AutomationProperties.Name="Back">
              <PathIcon Data="{StaticResource IconArrowLeft}" />
            </Button>

            <Button Grid.Column="1"
                    Classes="tool"
                    Command="{Binding SelectedTab.ForwardCommand}"
                    controls:MiddleClick.Command="{Binding SelectedTab.ForwardInNewTabCommand}"
                    IsEnabled="{Binding SelectedTab.CanGoForward}"
                    ToolTip.Tip="Forward"
                    AutomationProperties.Name="Forward">
              <PathIcon Data="{StaticResource IconArrowRight}" />
            </Button>

            <Panel Grid.Column="2">
              <Button Classes="tool"
                      IsVisible="{Binding !SelectedTab.IsLoading}"
                      IsEnabled="{Binding SelectedTab.IsWebPage}"
                      Command="{Binding SelectedTab.ReloadCommand}"
                      controls:MiddleClick.Command="{Binding SelectedTab.ReloadInNewTabCommand}"
                      ToolTip.Tip="Reload"
                      AutomationProperties.Name="Reload">
                <PathIcon Data="{StaticResource IconArrowClockwise}" />
              </Button>

              <Button Classes="tool"
                      IsVisible="{Binding SelectedTab.IsLoading}"
                      Command="{Binding SelectedTab.StopCommand}"
                      ToolTip.Tip="Stop"
                      AutomationProperties.Name="Stop">
                <PathIcon Data="{StaticResource IconDismiss}" Width="15" Height="15" />
              </Button>
            </Panel>

            <controls:AddressBox Grid.Column="3"
                                 Classes="address"
                                 Text="{Binding SelectedTab.AddressText}"
                                 IsEnabled="{Binding SelectedTab.IsWebPage}"
                                 Watermark="Search or enter address"
                                 AutomationProperties.Name="Address and search bar">
              <controls:AddressBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SelectedTab.SubmitCommand}" />
              </controls:AddressBox.KeyBindings>
            </controls:AddressBox>

            <Button Grid.Column="4"
                    Name="DownloadsButton"
                    Classes="tool"
                    IsVisible="{Binding HasDownloads}"
                    Command="{Binding ToggleDownloadsCommand}"
                    ToolTip.Tip="Downloads"
                    AutomationProperties.Name="Downloads">
              <PathIcon Data="{StaticResource IconDownload}" />
            </Button>

            <!-- Breeze's own downloads popup; the engine's is suppressed in WebView. A popup is a
                 window of its own, so it draws above the engine's native child window. -->
            <Popup Grid.Column="4"
                   IsOpen="{Binding IsDownloadsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding #DownloadsButton}"
                   Placement="BottomEdgeAlignedRight"
                   VerticalOffset="6"
                   IsLightDismissEnabled="True">
              <Border Classes="downloads">
                <StackPanel>
                  <TextBlock Text="Downloads"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Margin="4,0,0,10" />
                  <ItemsControl ItemsSource="{Binding Downloads}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:DownloadViewModel">
                        <Border Classes="download">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding FileName}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="mini"
                                    IsVisible="{Binding IsActive}"
                                    Command="{Binding CancelCommand}"
                                    ToolTip.Tip="Cancel"
                                    AutomationProperties.Name="Cancel download">
                              <PathIcon Data="{StaticResource IconDismiss}" />
                            </Button>

                            <ProgressBar Grid.Row="1"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="2"
                                         Margin="0,8,0,0"
                                         Height="4"
                                         MinHeight="4"
                                         CornerRadius="2"
                                         Value="{Binding Progress}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         ShowProgressText="False"
                                         Foreground="{DynamicResource AccentBrush}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,7,0,0"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlyphBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Detail}" />

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,5,0,0"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        IsVisible="{Binding IsCompleted}">
                              <Button Classes="link" Content="Open" Command="{Binding OpenCommand}" />
                              <Button Classes="link" Content="Show in folder" Command="{Binding OpenFolderCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,7,0,0"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsUnfinished}"
                                       Foreground="{DynamicResource GlyphBrush}"
                                       Text="{Binding Status}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Popup>

            <Button Grid.Column="5"
                    Classes="tool"
                    Command="{Binding ToggleBookmarkCommand}"
                    IsEnabled="{Binding CanBookmark}"
                    ToolTip.Tip="Bookmark this page"
                    AutomationProperties.Name="Bookmark this page">
              <Panel>
                <PathIcon Data="{StaticResource IconStar}"
                          IsVisible="{Binding !IsCurrentPageBookmarked}" />
                <PathIcon Data="{StaticResource IconStarFilled}"
                          Foreground="{DynamicResource AccentBrush}"
                          IsVisible="{Binding IsCurrentPageBookmarked}" />
              </Panel>
            </Button>

            <Button Grid.Column="6"
                    Classes="tool"
                    Command="{Binding SettingsCommand}"
                    ToolTip.Tip="Settings"
                    AutomationProperties.Name="Settings">
              <PathIcon Data="{StaticResource IconSettings}" />
            </Button>

          </Grid>
        </Border>

        <!-- Bookmark bar. Virtualized, so a long list costs only the entries on screen. -->
        <Border Classes="bookmarks" IsVisible="{Binding IsBookmarkBarVisible}">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Bookmarks}" AutomationProperties.Name="Bookmarks">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BookmarkViewModel">
                  <Button Classes="bookmark"
                          Command="{Binding OpenCommand}"
                          controls:MiddleClick.Command="{Binding OpenInNewTabCommand}"
                          ToolTip.Tip="{Binding Url}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Delete bookmark" Command="{Binding DeleteCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Panel Width="16" Height="16">
                        <Image Source="{Binding Icon}"
                               IsVisible="{Binding HasIcon}"
                               Width="16"
                               Height="16" />
                        <PathIcon Data="{StaticResource IconGlobe}"
                                  Foreground="{DynamicResource GlyphBrush}"
                                  IsVisible="{Binding !HasIcon}"
                                  Width="13"
                                  Height="13" />
                      </Panel>
                      <TextBlock Text="{Binding Title}"
                                 FontSize="12"
                                 MaxWidth="150"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding HostedTabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.DataTemplates>
        <!-- The settings tab is a native view, so it never creates a WebView2 instance. -->
        <DataTemplate DataType="vm:SettingsTabViewModel">
          <Panel IsVisible="{Binding IsSelected}">
            <views:SettingsView DataContext="{Binding Settings}" />
          </Panel>
        </DataTemplate>
        <DataTemplate DataType="vm:TabViewModel">
          <controls:WebView Source="{Binding Address, Mode=TwoWay}"
                            DocumentTitle="{Binding DocumentTitle, Mode=TwoWay}"
                            Favicon="{Binding Favicon, Mode=TwoWay}"
                            CanGoBack="{Binding CanGoBack, Mode=TwoWay}"
                            CanGoForward="{Binding CanGoForward, Mode=TwoWay}"
                            IsLoading="{Binding IsLoading, Mode=TwoWay}"
                            IsVisible="{Binding IsSelected}" />
        </DataTemplate>
      </ItemsControl.DataTemplates>
    </ItemsControl>

  </DockPanel>

</Window>
